# Turso
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth
# Any long random string — used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Password every seeded user gets on first boot (users table only seeds once,
# when it's empty). Change each user's real password after first login —
# see README "First login" section.
DEFAULT_USER_PASSWORD=waypoint2026

PORT=3000
